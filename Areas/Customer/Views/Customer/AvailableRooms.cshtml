                <a href="/Customer/Customer/BookRoom?type=deluxe" class="btn btn-primary btn-sm">Reserve</a>
            </div>
        </div>
    </div>

    <!-- Room 5 -->
    <div class="cogstay-room-card" data-room-type="suite" data-room-price="360">
        <div class="cogstay-room-image" style="background-image: url('https://images.unsplash.com/photo-1578683010236-d716f9a3f461?auto=format&fit=crop&w=600&q=85')">
            <span class="cogstay-room-badge">Available</span>
        </div>
        <div class="cogstay-room-body">
            <h3 class="cogstay-room-title">Presidential Suite 401</h3>
            <p style="color: var(--color-text-muted); font-size: 13px; margin-bottom: 12px;">Extra large king master suite, bar area, bath amenities, private terrace.</p>
            <ul class="cogstay-room-amenities">
                <li class="cogstay-room-amenity"><i class="fa-solid fa-martini-glass-citrus"></i> Bar</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-bath"></i> Marble Tub</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-sun"></i> Terrace</li>
            </ul>
            <div class="cogstay-room-footer">
                <div class="cogstay-room-price">$360 <span>/ night</span></div>
                <a href="/Customer/Customer/BookRoom?type=suite" class="btn btn-primary btn-sm">Reserve</a>
            </div>
        </div>
    </div>

    <!-- Room 6 -->
    <div class="cogstay-room-card" data-room-type="standard" data-room-price="135">
        <div class="cogstay-room-image" style="background-image: url('https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=600&q=85')">
            <span class="cogstay-room-badge">Available</span>
        </div>
        <div class="cogstay-room-body">
            <h3 class="cogstay-room-title">Superior King 202</h3>
            <p style="color: var(--color-text-muted); font-size: 13px; margin-bottom: 12px;">Standard bedding, walk-in shower room, smart thermostat control.</p>
            <ul class="cogstay-room-amenities">
                <li class="cogstay-room-amenity"><i class="fa-solid fa-wifi"></i> Wifi</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-snowflake"></i> AC</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-tv"></i> TV</li>
            </ul>
            <div class="cogstay-room-footer">
                <div class="cogstay-room-price">$135 <span>/ night</span></div>
                <a href="/Customer/Customer/BookRoom?type=standard" class="btn btn-primary btn-sm">Reserve</a>
            </div>
        </div>
    </div>
</div>
