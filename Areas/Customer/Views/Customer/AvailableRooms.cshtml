            </div>
            <ul class="cogstay-room-amenities">
                <li class="cogstay-room-amenity"><i class="fa-solid fa-wifi"></i> Wifi</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-snowflake"></i> AC</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-tv"></i> TV</li>
            </ul>
            <div class="cogstay-room-footer">
                <div class="cogstay-room-price">₹11,200 <span>/ night</span></div>
                <a href="/Customer/Customer/BookRoom?type=standard" class="btn btn-primary btn-sm">Reserve</a>
            </div>
        </div>
    </div>

    <!-- Room 4 -->
    <div class="cogstay-room-card" data-room-type="deluxe" data-room-price="14800">
        <div class="cogstay-room-image-container">
            <img src="/images/rooms/room_deluxe.png" class="cogstay-room-card-img" alt="Deluxe Executive Room 302" />
            <span class="cogstay-room-badge">Available</span>
        </div>
        <div class="cogstay-room-body">
            <h3 class="cogstay-room-title">Deluxe Executive Room 302</h3>
