            </ul>
            <div class="cogstay-room-footer">
                <div class="cogstay-room-price">₹14,800 <span>/ night</span></div>
                <a href="/Customer/Customer/BookRoom?type=deluxe" class="btn btn-primary btn-sm">Reserve</a>
            </div>
        </div>
    </div>

    <!-- Room 5 -->
    <div class="cogstay-room-card" data-room-type="suite" data-room-price="28800">
        <div class="cogstay-room-image-container">
            <img src="/images/rooms/room_suite.png" class="cogstay-room-card-img" alt="Presidential Suite 401" />
            <span class="cogstay-room-badge">Available</span>
        </div>
        <div class="cogstay-room-body">
            <h3 class="cogstay-room-title">Presidential Suite 401</h3>
            <p style="color: var(--color-text-muted); font-size: 13px; margin-bottom: 8px;">Extra large king master suite, bar area, bath amenities, private terrace.</p>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-users"></i> Occupancy: Max 6 Guests
            </div>
            <ul class="cogstay-room-amenities">
                <li class="cogstay-room-amenity"><i class="fa-solid fa-martini-glass-citrus"></i> Bar</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-bath"></i> Marble Tub</li>
                <li class="cogstay-room-amenity"><i class="fa-solid fa-sun"></i> Terrace</li>
            </ul>
            <div class="cogstay-room-footer">
                <div class="cogstay-room-price">₹28,800 <span>/ night</span></div>
                <a href="/Customer/Customer/BookRoom?type=suite" class="btn btn-primary btn-sm">Reserve</a>
            </div>
        </div>
    </div>

    <!-- Room 6 -->
    <div class="cogstay-room-card" data-room-type="standard" data-room-price="10800">
        <div class="cogstay-room-image-container">
            <img src="/images/rooms/room_standard.png" class="cogstay-room-card-img" alt="Superior King 202" />
            <span class="cogstay-room-badge">Available</span>
        </div>
        <div class="cogstay-room-body">
            <h3 class="cogstay-room-title">Superior King 202</h3>
            <p style="color: var(--color-text-muted); font-size: 13px; margin-bottom: 8px;">Standard bedding, walk-in shower room, smart thermostat control.</p>
            <div style="font-size: 13px; color: var(--color-text-muted); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-users"></i> Occupancy: Max 2 Guests
            </div>
            <ul class="cogstay-room-amenities">
                <li class="cogstay-room-amenity"><i class="fa-solid fa-wifi"></i> Wifi</li>
